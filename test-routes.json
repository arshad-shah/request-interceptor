    {
      "routeType": "websocket",
      "url": "wss://echo.websocket.org",
      "name": "WS Echo - Replace incoming",
      "enabled": true,
      "delay": 0,
      "incomingRules": [
        {
          "id": "ws-rule-1",
          "enabled": true,
          "type": "replace",
          "matchType": "contains",
          "match": "hello",
          "replacement": "INTERCEPTED: hello",
          "description": "Prefix incoming hello messages"
        },
        {
          "id": "ws-rule-2",
          "enabled": true,
          "type": "block",
          "matchType": "exact",
          "match": "secret",
          "description": "Block incoming 'secret' messages"
        },
        {
          "id": "ws-rule-3",
          "enabled": true,
          "type": "replace",
          "matchType": "regex",
          "match": "\\d{3,}",
          "replacement": "***",
          "flags": "g",
          "description": "Redact numbers with 3+ digits"
        }
      ],
      "outgoingRules": [
        {
          "id": "ws-rule-4",
          "enabled": true,
          "type": "replace",
          "matchType": "contains",
          "match": "password",
          "replacement": "p*******",
          "description": "Mask outgoing password text"
        },
        {
          "id": "ws-rule-5",
          "enabled": true,
          "type": "inject",
          "matchType": "exact",
          "match": "ping",
          "replacement": "{\"type\":\"injected\",\"data\":\"extra message\"}",
          "description": "Inject extra message after ping"
        }
      ]
    },
    {
      "routeType": "websocket",
      "url": "wss://ws.postman-echo.com/raw",
      "name": "WS Postman - Block & inject",
      "enabled": true,
      "delay": 100,
      "incomingRules": [
        {
          "id": "ws-rule-6",
          "enabled": true,
          "type": "block",
          "matchType": "regex",
          "match": "error|fail",
          "flags": "i",
          "description": "Block error/fail messages"
        }
      ],
      "outgoingRules": [
        {
          "id": "ws-rule-7",
          "enabled": true,
          "type": "inject",
          "matchType": "contains",
          "match": "subscribe",
          "replacement": "{\"type\":\"auth\",\"token\":\"test-token-123\"}",
          "description": "Auto-inject auth before subscribe"
        }
      ]
    },
    {
      "routeType": "injection",
      "urlPattern": "http://localhost:*",
      "name": "Local dev - custom styles",
      "enabled": true,
      "scripts": [],
      "stylesheets": ["body { border: 5px solid red !important; } h1 { color: blue !important; }"],
      "injectAt": "document_end"
    },
    {
      "routeType": "injection",
      "urlPattern": "https://jsonplaceholder.typicode.com/*",
      "name": "JSONPlaceholder - inject script",
      "enabled": true,
      "scripts": ["console.log('[Interceptor] Script injected!'); document.title = 'INTERCEPTED: ' + document.title;"],
      "stylesheets": ["body { background: #1a1a2e !important; color: #e0e0e0 !important; }"],
      "injectAt": "document_end"
    }
