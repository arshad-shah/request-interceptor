### Error Handling Conventions

#### Error Naming and Structure
```tsx
// Custom error classes: Error + Purpose
class RouteValidationError extends Error {
  constructor(message: string, public field: string) {
    super(message);
    this.name = 'RouteValidationError';
  }
}

class ChromeApiError extends Error {
  constructor(message: string, public chromeError?: chrome.runtime.LastError) {
    super(message);
    this.name = 'ChromeApiError';
  }
}

// Error handling utilities
const handleAsyncError = async <T>(
  operation: () => Promise<T>,
  context: string
): Promise<T> => {
  try {
    return await operation();
  } catch (error) {
    console.error(`Error in ${context}:`, error);
    throw new Error(`${context} failed: ${error.message}`);
  }
};
```