# Request Interceptor Extension - Naming & Structure Conventions
## Consistent naming, file organization, and structural standards

### File and Directory Naming

#### Directory Structure
```
src/
├── components/              # React components
│   ├── ui/                 # Reusable UI components
│   ├── forms/              # Form-specific components
│   ├── modals/             # Modal dialogs
│   └── layout/             # Layout components
├── hooks/                  # Custom React hooks
├── lib/                    # Utility libraries
├── stores/                 # Zustand stores
├── types/                  # TypeScript type definitions
├── config/                 # Configuration files
├── assets/                 # Static assets
├── popup/                  # Popup-specific code
├── sidepanel/             # Sidepanel-specific code
└── __tests__/             # Global test utilities
```

#### File Naming Conventions
- **Components**: PascalCase (e.g., `RouteItem.tsx`, `AddRouteForm.tsx`)
- **Hooks**: camelCase with "use" prefix (e.g., `useAppStore.ts`, `useRouteManagement.ts`)
- **Utilities**: camelCase (e.g., `utils.ts`, `validation.ts`)
- **Types**: camelCase (e.g., `index.ts`, `route-types.ts`)
- **Constants**: SCREAMING_SNAKE_CASE (e.g., `API_ENDPOINTS.ts`)
- **Test files**: Match component name + `.test.ts(x)` (e.g., `RouteItem.test.tsx`)

#### Component File Organization
```
ComponentName.tsx           # Main component
ComponentName.test.tsx      # Component tests
ComponentName.stories.tsx   # Storybook stories (if applicable)
types.ts                   # Component-specific types (if many)
```

### Naming Conventions

#### TypeScript Interfaces & Types
```tsx
// Interfaces: PascalCase with descriptive names
interface RouteConfig {
  status: number;
  delay: number;
  enabled: boolean;
}

// Component Props: ComponentName + Props suffix
interface RouteItemProps {
  route: RouteConfig;
  onEdit?: () => void;
}

// Union Types: PascalCase with descriptive names
type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE';
type NotificationType = 'success' | 'error' | 'warning' | 'info';

// Generic Interfaces: Use single letters or descriptive names
interface ApiResponse<TData> {
  data: TData;
  status: number;
}

// Enums: PascalCase for enum name, SCREAMING_SNAKE_CASE for values
enum RouteStatus {
  ACTIVE = 'ACTIVE',
  INACTIVE = 'INACTIVE',
  DISABLED = 'DISABLED'
}
```

#### Variables and Functions
```tsx
// Variables: camelCase
const routeList = [];
const isLoading = false;
const maxRetryCount = 3;

// Functions: camelCase with verb prefix
const handleRouteClick = () => {};
const validateRouteUrl = (url: string) => {};
const fetchUserRoutes = async () => {};

// Boolean variables/functions: is/has/can/should prefix
const isEnabled = true;
const hasError = false;
const canEdit = true;
const shouldRefresh = false;

// Constants: SCREAMING_SNAKE_CASE
const API_BASE_URL = 'https://api.example.com';
const MAX_ROUTES_PER_PAGE = 50;
const DEFAULT_TIMEOUT = 5000;
```

#### React Component Conventions
```tsx
// Component name matches file name
const RouteItem: React.FC<RouteItemProps> = () => {
  // State variables: descriptive camelCase
  const [isEditing, setIsEditing] = useState(false);
  const [formData, setFormData] = useState<RouteFormData>({});
  const [validationErrors, setValidationErrors] = useState<string[]>([]);

  // Event handlers: handle + Action pattern
  const handleSubmit = (e: React.FormEvent) => {};
  const handleCancel = () => {};
  const handleInputChange = (field: string, value: string) => {};

  // Effects and computations: descriptive names
  const isFormValid = useMemo(() =>
    formData.url && formData.method && !validationErrors.length,
    [formData, validationErrors]
  );

  return (
    <div className="route-item">
      {/* Component content */}
    </div>
  );
};

export default RouteItem;
```

### CSS/Tailwind Conventions

#### Class Naming Patterns
```tsx
// Base component classes: component-purpose
<div className="route-item">                    // Main container
  <div className="route-item__header">          // Component section
    <div className="route-item__title">         // Element
      <span className="route-item__status">     // Sub-element
```

#### Tailwind Class Organization
```tsx
// Order: Layout -> Spacing -> Typography -> Colors -> Effects
className={cn(
  // Layout
  "flex flex-col items-center justify-between",
  // Spacing
  "p-4 m-2 space-y-3",
  // Typography
  "text-sm font-medium",
  // Colors
  "bg-white text-gray-900 border-gray-200",
  // Effects
  "shadow-lg rounded-lg transition-all duration-200",
  // States
  "hover:bg-gray-50 focus:ring-2 focus:ring-blue-500",
  // Responsive
  "md:flex-row md:space-y-0 md:space-x-4",
  // Conditional
  isActive && "bg-blue-50 border-blue-200",
  className
)}
```

#### Component Variant Patterns
```tsx
// Variant object naming: variants, not styles
const variants = {
  primary: "bg-blue-600 text-white hover:bg-blue-700",
  secondary: "bg-gray-100 text-gray-700 hover:bg-gray-200",
  danger: "bg-red-600 text-white hover:bg-red-700"
};

// Size object naming: sizes, not dimensions
const sizes = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-4 py-2 text-base",
  lg: "px-6 py-3 text-lg"
};
```

### Store and State Management Conventions

#### Zustand Store Structure
```tsx
interface StoreState {
  // State: nouns
  routes: Record<string, RouteConfig>;
  activeTab: TabId;
  isLoading: boolean;

  // Actions: verbs
  setRoutes: (routes: Record<string, RouteConfig>) => void;
  addRoute: (key: string, config: RouteConfig) => void;
  removeRoute: (key: string) => void;
  toggleRoute: (key: string, enabled: boolean) => void;
}

// Store naming: use + Entity + Store
export const useAppStore = create<AppStoreState>((set, get) => ({
  // Initial state first
  routes: {},
  activeTab: 'routes',
  isLoading: false,

  // Actions second, grouped by purpose
  // Route actions
  setRoutes: (routes) => set({ routes }),
  addRoute: (key, config) => set((state) => ({
    routes: { ...state.routes, [key]: config }
  })),
  // ... other route actions

  // UI actions
  setActiveTab: (tab) => set({ activeTab: tab }),
  // ... other UI actions
}));
```

#### State Update Patterns
```tsx
// Simple updates: direct assignment
set({ isLoading: true });

// Complex updates: function form
set((state) => ({
  routes: {
    ...state.routes,
    [key]: { ...state.routes[key], enabled: !state.routes[key].enabled }
  }
}));

// Derived state: use get() in actions
const getActiveRoutes = () => {
  const { routes } = get();
  return Object.entries(routes).filter(([_, config]) => config.enabled);
};
```

### API and Data Conventions

#### Route Key Patterns
```tsx
// HTTP routes: METHOD:URL
const httpRouteKey = 'GET:https://api.example.com/users';
const httpRouteKey2 = 'POST:https://api.example.com/users';

// WebSocket routes: WS:URL
const wsRouteKey = 'WS:wss://api.example.com/live';

// Key parsing utilities
const parseRouteKey = (key: string) => {
  if (key.startsWith('WS:')) {
    return { type: 'websocket', url: key.substring(3) };
  }

  const [method, url] = key.split(':', 2);
  return { type: 'http', method, url };
};
```

#### Chrome Message Patterns
```tsx
// Message action naming: VERB_NOUN pattern
interface ChromeMessage {
  action: 'GET_ROUTES' | 'SET_ROUTES' | 'TOGGLE_ENABLED' | 'UPDATE_ROUTE';
  data?: any;
  tabId?: number;
}

// Message handlers: handle + ActionName
const handleGetRoutes = async () => {
  // Implementation
};

const handleSetRoutes = async (routes: Record<string, RouteConfig>) => {
  // Implementation
};
```

### Testing Conventions

#### Test File Organization
```tsx
// Test suite naming: Component/Function name
describe('RouteItem', () => {
  // Test group naming: descriptive behavior
  describe('when route is enabled', () => {
    // Test case naming: should + expected behavior
    it('should display toggle as checked', () => {});
    it('should allow editing when edit button is clicked', () => {});
  });

  describe('when route is disabled', () => {
    it('should display toggle as unchecked', () => {});
    it('should show disabled styling', () => {});
  });
});
```

#### Mock Naming Conventions
```tsx
// Mock functions: mock + FunctionName
const mockToggleRoute = vi.fn();
const mockHandleSubmit = vi.fn();

// Mock data: mock + DataType
const mockRoute: RouteConfig = {
  status: 200,
  delay: 0,
  response: {},
  contentType: 'application/json',
  enabled: true,
  timestamp: Date.now()
};

// Test utilities: render + Context
const renderWithStore = (component: React.ReactElement) => {
  // Implementation
};
```

### Import and Export Conventions

#### Import Organization
```tsx
// 1. React imports first
import React, { useState, useEffect, useMemo } from 'react';

// 2. Third-party libraries
import { motion } from 'framer-motion';
import { ChevronDown, Edit, Trash2 } from 'lucide-react';

// 3. Internal imports (absolute paths with aliases)
import { cn } from '@/lib/utils';
import { RouteConfig, HttpMethod } from '@/types';
import { useAppStore } from '@/stores/app-store';
import Button from '@/components/ui/Button';

// 4. Relative imports last
import './ComponentName.css'; // Only if CSS modules used
```

#### Export Conventions
```tsx
// Default export for main component
export default ComponentName;

// Named exports for utilities, types, constants
export { validateUrl, formatDate };
export type { ComponentProps };
export const API_ENDPOINTS = {
  USERS: '/api/users',
  ROUTES: '/api/routes'
};

// Barrel exports in index.ts files
export { default as Button } from './Button';
export { default as Input } from './Input';
export type { ButtonProps, InputProps } from './types';
```

