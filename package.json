{
  "name": "request-interceptor",
  "version": "3.1.0",
  "description": "Developer toolkit browser extension for intercepting API responses, monitoring events, and inspecting browser storage. Manifest V3, cross-browser.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Arshad Shah",
    "email": "shaharshad57@gmail.com",
    "url": "https://github.com/arshad-shah"
  },
  "homepage": "https://github.com/arshad-shah/request-interceptor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/request-interceptor.git"
  },
  "bugs": {
    "url": "https://github.com/arshad-shah/request-interceptor/issues"
  },
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "manifest-v3",
    "api",
    "mock",
    "intercept",
    "fetch",
    "xhr",
    "websocket",
    "devtools",
    "extforge"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "type": "module",
  "scripts": {
    "dev": "extforge dev",
    "build": "extforge build",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "ace-builds": "^1.43.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.540.0",
    "react": "^18.3.1",
    "react-ace": "^14.0.1",
    "react-dom": "^18.3.1",
    "react-syntax-highlighter": "^15.6.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@swc/core": "^1.15.33",
    "@tailwindcss/cli": "^4.2.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.246",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "extforge": "^0.3.1",
    "jsdom": "^26.1.0",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "prismjs": ">=1.30.0",
      "esbuild": ">=0.25.0",
      "js-yaml": ">=4.1.1"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}