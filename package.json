{
  "name": "request-interceptor",
  "version": "3.1.0",
  "description": "Developer toolkit browser extension for intercepting API responses, monitoring events, and inspecting browser storage. Manifest V3, cross-browser.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Arshad Shah",
    "email": "shaharshad57@gmail.com",
    "url": "https://github.com/arshad-shah"
  },
  "homepage": "https://github.com/arshad-shah/request-interceptor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/request-interceptor.git"
  },
  "bugs": {
    "url": "https://github.com/arshad-shah/request-interceptor/issues"
  },
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "manifest-v3",
    "api",
    "mock",
    "intercept",
    "fetch",
    "xhr",
    "websocket",
    "devtools",
    "extforge"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.1.2",
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.1.2"
  },
  "type": "module",
  "scripts": {
    "dev": "extforge dev",
    "build": "extforge build",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "brand": "node scripts/brand.ts",
    "brand:check": "node scripts/brand.ts --check",
    "verify": "pnpm type-check && pnpm lint && pnpm test:run && pnpm brand:check && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@arshad-shah/log-kit": "1.1.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-select": "^2.2.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.540.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@swc/core": "^1.15.33",
    "@tailwindcss/cli": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.42",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "extforge": "^1.4.0",
    "jsdom": "^29.1.1",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild"
    ]
  }
}
